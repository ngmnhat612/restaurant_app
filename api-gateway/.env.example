# api-gateway/.env

# Server Configuration
PORT=3000
NODE_ENV=development

# ===== MICROSERVICES URLs =====
# ⚠️ ĐẢM BẢO PORT KHỚP VỚI CÁC SERVICE
ACCOUNT_SERVICE_URL=http://localhost:5002
BRANCH_SERVICE_URL=http://localhost:5001
MENU_SERVICE_URL=http://localhost:5003
ORDER_SERVICE_URL=http://localhost:5004
INGREDIENT_SERVICE_URL=http://localhost:5005

# JWT Configuration
# ⚠️ PHẢI GIỐNG VỚI ACCOUNT SERVICE
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRES_IN=24h

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Request Configuration
REQUEST_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Health Check
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000